# Required: server-side TMDB credentials (never expose to the frontend).
TMDB_API_KEY=your_tmdb_api_key_here
# Optional v4 bearer token (preferred when available; keeps credentials out of URLs).
# TMDB_READ_ACCESS_TOKEN=

# Exact allowed frontend origins, comma-separated without trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# "production" hides /docs, enables HSTS, and validates deployment settings on startup.
APP_ENV=development
# Optional comma-separated Host allowlist (e.g. api.example.com).
# ALLOWED_HOSTS=
# Persistent directory for SQLite databases and temp uploads (defaults to backend/).
# DATA_DIR=
# Number of reverse proxies appending to X-Forwarded-For (0 for local development).
TRUSTED_PROXY_HOPS=0

# Optional tuning (defaults shown)
# MAX_UPLOAD_BYTES=10485760
# MAX_ACTIVE_JOBS=2
# MAX_QUEUED_JOBS=3
# QUEUE_WAIT_TIMEOUT_SECONDS=300
# MAX_UNIQUE_MOVIES=6000
# JOB_TTL_SECONDS=1800
# UPLOADS_PER_HOUR=20
# POLLS_PER_MINUTE=300
# EXPORTS_PER_MINUTE=10
# TMDB_MISS_TTL_DAYS=7
# LOG_LEVEL=INFO
