# ── Required ──────────────────────────────────────────────────────────────────────────────
# Server-side secret. Never commit a real key or expose it to the frontend.
TMDB_API_KEY=your_tmdb_api_key_here
# Optional alternative: TMDB's v4 "API Read Access Token". When set it is sent
# as a bearer header, which keeps the credential out of request URLs.
# TMDB_READ_ACCESS_TOKEN=

# Comma-separated exact frontend origins (no trailing slash). In production,
# set this to your deployed frontend URL / custom domain; localhost is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Deployment ─────────────────────────────────────────────────────────────────────────────
# "production" hides /docs, enables HSTS, and refuses to start if misconfigured.
APP_ENV=development
# Comma-separated hostnames this API answers to, e.g. api.example.com
# ALLOWED_HOSTS=
# Where SQLite files and temp uploads live (default: the backend folder).
# In production, use a persistent-disk mount path such as /var/data to keep the TMDB cache.
# DATA_DIR=
# Reverse proxies in front of the app that append to X-Forwarded-For (typically 1 behind a cloud proxy).
# Leave at 0 for local development.
TRUSTED_PROXY_HOPS=0

# ── Optional tuning (defaults shown) ───────────────────────────────────────────────────────────────────────────
# MAX_UPLOAD_BYTES=10485760
# MAX_ACTIVE_JOBS=2
# MAX_UNIQUE_MOVIES=6000
# JOB_TTL_SECONDS=1800
# UPLOADS_PER_HOUR=20
# POLLS_PER_MINUTE=300
# EXPORTS_PER_MINUTE=10
# TMDB_MISS_TTL_DAYS=7
# LOG_LEVEL=INFO
