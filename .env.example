# Frontend (Vite). Only variables starting with VITE_ are bundled into the public site,
# so never put secrets here.
#
# Local development (FastAPI on port 8000):
VITE_API_BASE_URL=http://localhost:8000/api
#
# Production: set VITE_API_BASE_URL in the Vercel project settings to your Render URL,
# e.g. https://cinestats-api.onrender.com/api  (then redeploy).
